generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {

  id String @id @default(uuid())

  username String @unique

  password String

  list_access String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

}